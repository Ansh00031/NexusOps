# NexusOps Environment Configuration
# Set MOCK_MODE=false and provide GEMINI_API_KEY to use live Gemini API
MOCK_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Enterprise Server Port
PORT=8080
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./nexusops.db

# Chaos Mode (simulates transient microservice 503 failures)
CHAOS_MODE=false
